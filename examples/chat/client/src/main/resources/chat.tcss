/* gRPC Chat — TamboUI Theme */

$accent: cyan;
$border: dark-gray;
$header-border: cyan;
$messages-border: green;
$timestamp: dark-gray;
$separator: dark-gray;
$status-connected: green;
$status-disconnected: red;
$status-error: red;
$status-info: dark-gray;

$user-1: cyan;
$user-2: yellow;
$user-3: green;
$user-4: magenta;
$user-5: light-red;
$user-6: light-blue;
$user-7: light-cyan;
