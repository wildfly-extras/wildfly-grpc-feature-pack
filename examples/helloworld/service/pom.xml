<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wildfly.grpc</groupId>
        <artifactId>wildfly-grpc-examples-helloworld</artifactId>
        <version>0.2.2-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>wildfly-grpc-examples-helloworld-service</artifactId>
    <packaging>war</packaging>
    <name>WildFly gRPC :: Examples :: Hello World :: Service</name>

    <properties>
        <root.directory>${basedir}/../../..</root.directory>
        <wildfly.home>${project.build.directory}/wildfly</wildfly.home>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>wildfly-grpc-examples-helloworld-proto</artifactId>
            <!-- The gRPC and protobuf jars are provided at runtime by the
                 WildFly module system (org.wildfly.grpc-dependency / io.grpc-all).
                 Marking provided prevents them from being bundled in WEB-INF/lib,
                 which would expose internal gRPC classes to Jandex scanning. -->
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-proto</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>wildfly-grpc-examples-helloworld-proto</artifactId>
                                    <version>${project.version}</version>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/proto</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile-proto</id>
                        <goals>
                            <goal>compile</goal>
                            <goal>compile-custom</goal>
                        </goals>
                        <configuration>
                            <protoSourceRoot>${project.build.directory}/proto</protoSourceRoot>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <configuration>
                    <jboss-home>${wildfly.home}</jboss-home>
                    <provisioningDir>${wildfly.home}</provisioningDir>
                    <feature-packs>
                        <feature-pack>
                            <groupId>org.wildfly</groupId>
                            <artifactId>wildfly-galleon-pack</artifactId>
                            <version>${version.wildfly}</version>
                        </feature-pack>
                        <feature-pack>
                            <groupId>${project.groupId}</groupId>
                            <artifactId>wildfly-grpc-feature-pack</artifactId>
                            <version>${project.version}</version>
                        </feature-pack>
                    </feature-packs>
                    <layers>
                        <layer>jaxrs-server</layer>
                        <layer>grpc</layer>
                    </layers>
                    <galleon-options>
                        <jboss-fork-embedded>${galleon.fork.embedded}</jboss-fork-embedded>
                        <stability-level>preview</stability-level>
                    </galleon-options>
                    <log-provisioning-time>${galleon.log.time}</log-provisioning-time>
                    <stability>preview</stability>
                </configuration>
                <executions>
                    <execution>
                        <id>provision-server</id>
                        <goals>
                            <goal>package</goal>
                        </goals>
                        <phase>package</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>ssl-none</id>
            <activation>
                <property>
                    <name>ssl</name>
                    <value>none</value>
                </property>
            </activation>
        </profile>
        <profile>
            <id>ssl-oneway</id>
            <activation>
                <property>
                    <name>ssl</name>
                    <value>oneway</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-keystore-oneway</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/server-content/standalone/configuration</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${root.directory}/ssl</directory>
                                            <includes>
                                                <include>server.keystore.jks</include>
                                            </includes>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.wildfly.plugins</groupId>
                        <artifactId>wildfly-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>provision-server</id>
                                <configuration>
                                    <extra-server-content-dirs>
                                        <extra-content-dir>${project.build.directory}/server-content</extra-content-dir>
                                    </extra-server-content-dirs>
                                    <packaging-scripts>
                                        <execution>
                                            <scripts>
                                                <script>${root.directory}/ssl/configure-elytron-oneway.cli</script>
                                            </scripts>
                                        </execution>
                                    </packaging-scripts>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>ssl-twoway</id>
            <activation>
                <property>
                    <name>ssl</name>
                    <value>twoway</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-keystore-twoway</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/server-content/standalone/configuration</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${root.directory}/ssl</directory>
                                            <includes>
                                                <include>server.keystore.jks</include>
                                                <include>server.truststore.jks</include>
                                            </includes>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.wildfly.plugins</groupId>
                        <artifactId>wildfly-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>provision-server</id>
                                <configuration>
                                    <extra-server-content-dirs>
                                        <extra-content-dir>${project.build.directory}/server-content</extra-content-dir>
                                    </extra-server-content-dirs>
                                    <packaging-scripts>
                                        <execution>
                                            <scripts>
                                                <script>${root.directory}/ssl/configure-elytron-twoway.cli</script>
                                            </scripts>
                                        </execution>
                                    </packaging-scripts>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
