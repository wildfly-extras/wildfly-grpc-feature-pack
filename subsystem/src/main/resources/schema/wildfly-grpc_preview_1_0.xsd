<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:wildfly:grpc:preview:1.0"
           xmlns="urn:wildfly:grpc:preview:1.0"
           elementFormDefault="qualified"
           version="1.0">

    <!-- The subsystem root element -->
    <xs:element name="subsystem" type="grpc-subsystemType"/>

    <xs:complexType name="grpc-subsystemType">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                The configuration of the gRPC subsystem.
                gRPC services are served via WildFly's Undertow HTTP/2 stack on the configured virtual host.
                TLS is configured on the Undertow https-listener, not here.
            ]]>
            </xs:documentation>
        </xs:annotation>
            <xs:attribute name="keep-alive-time" type="nonnegativeJavaInt" />
            <xs:attribute name="keep-alive-timeout" type="nonnegativeJavaInt" />
            <xs:attribute name="max-concurrent-calls-per-connection" type="nonnegativeJavaInt" />
            <xs:attribute name="max-connection-age" type="nonnegativeJavaInt" />
            <xs:attribute name="max-connection-age-grace" type="nonnegativeJavaInt" />
            <xs:attribute name="max-connection-idle" type="nonnegativeJavaInt" />
            <xs:attribute name="max-inbound-message-size" type="nonnegativeJavaInt" default="4194304" />
            <xs:attribute name="max-inbound-metadata-size" type="nonnegativeJavaInt" default="8192"/>
            <xs:attribute name="permit-keep-alive-time" type="nonnegativeJavaInt" default="250" />
            <xs:attribute name="permit-keep-alive-without-calls" type="xs:boolean" default="false" />
            <xs:attribute name="server-name" type="xs:string" default="default-server" />
            <xs:attribute name="shutdown-timeout" type="nonnegativeJavaInt" />
            <xs:attribute name="virtual-host" type="xs:string" default="default-host" />
    </xs:complexType>

    <xs:simpleType name="nonnegativeJavaInt" id="nonnegativeJavaInt">
        <xs:restriction base="xs:unsignedLong">
            <xs:maxInclusive value="2147483647"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
