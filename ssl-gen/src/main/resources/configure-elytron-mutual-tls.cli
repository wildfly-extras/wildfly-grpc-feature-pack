# Adds mutual TLS (mTLS) on top of the one-way TLS setup from configure-elytron-tls.cli.
# Run configure-elytron-tls.cli before this script.
#
# Creates the following additional Elytron resources:
#   - trust-store: loads server.truststore.p12 (contains the trusted client certificate)
#   - trust-manager: wraps the trust-store to verify client certificates
#
# Updates the existing server-ssl-context to:
#   - require client certificate authentication (need-client-auth=true)
#   - use the trust-manager to verify the client's certificate

# Guard on the trust-manager: if it already exists, mutual auth is already configured
if (outcome != success) of /subsystem=elytron/trust-manager=grpc-trust-manager:read-resource
    /subsystem=elytron/key-store=grpc-trust-store:add(credential-reference={clear-text="secret"}, type=PKCS12, required=false, path="server.truststore.p12", relative-to="jboss.server.config.dir")
    /subsystem=elytron/trust-manager=grpc-trust-manager:add(key-store="grpc-trust-store")
    /subsystem=elytron/server-ssl-context=grpc-ssl-context:write-attribute(name=need-client-auth, value=true)
    /subsystem=elytron/server-ssl-context=grpc-ssl-context:write-attribute(name=trust-manager, value="grpc-trust-manager")
end-if
